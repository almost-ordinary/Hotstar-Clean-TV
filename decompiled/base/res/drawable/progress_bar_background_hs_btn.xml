<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:topLeftRadius="@dimen/button_border_inner_radius" android:topRightRadius="@dimen/button_border_inner_radius" android:bottomLeftRadius="@dimen/button_border_inner_radius" android:bottomRightRadius="@dimen/button_border_inner_radius" />
            <solid android:color="@color/white_60A" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:topLeftRadius="@dimen/button_border_inner_radius" android:topRightRadius="@dimen/button_border_inner_radius" android:bottomLeftRadius="@dimen/button_border_inner_radius" android:bottomRightRadius="@dimen/button_border_inner_radius" />
                <solid android:color="@color/white" />
            </shape>
        </clip>
    </item>
</layer-list>
