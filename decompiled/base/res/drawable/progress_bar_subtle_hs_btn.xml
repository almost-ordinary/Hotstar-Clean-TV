<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:bottomLeftRadius="12.0dp" android:bottomRightRadius="12.0dp" />
            <solid android:color="@color/seekbar_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:bottomLeftRadius="12.0dp" android:bottomRightRadius="12.0dp" />
                <solid android:color="@color/binge_blue_05" />
            </shape>
        </clip>
    </item>
</layer-list>
