<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:bottomLeftRadius="@dimen/radius_04" android:bottomRightRadius="@dimen/radius_04" />
            <solid android:color="@color/seekbar_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:bottomLeftRadius="@dimen/radius_04" android:bottomRightRadius="@dimen/radius_04" />
                <solid android:color="@color/seekbar_highlight_alt" />
            </shape>
        </clip>
    </item>
</layer-list>
